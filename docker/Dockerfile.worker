FROM python:3.12-slim

WORKDIR /app

COPY services/workers/python/requirements.txt /app/services/workers/python/requirements.txt
RUN pip install --no-cache-dir -r /app/services/workers/python/requirements.txt

COPY services/workers/python /app/services/workers/python
COPY data/sample /app/data/sample

ENTRYPOINT ["python", "services/workers/python/service/main.py"]
